rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // 10 MB upload cap, JPEG/PNG only.
    function isImage() {
      return request.resource.size < 10 * 1024 * 1024
        && (request.resource.contentType.matches('image/jpe?g')
            || request.resource.contentType.matches('image/png'));
    }
    function isSignedIn() { return request.auth != null; }

    // Profile pictures live under `users/{uid}/profile/...`
    match /users/{userId}/profile/{file=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId && isImage();
    }

    // Contractor portfolio photos
    match /contractors/{userId}/portfolio/{file=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId && isImage();
    }

    // Job requirement photos — only the job's creator can write, verified
    // against the Firestore job document (cross-service rules).
    match /jobs/{jobId}/requirements/{file=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn()
        && isImage()
        && firestore.get(/databases/(default)/documents/jobs/$(jobId)).data.createdBy == request.auth.uid;
    }

    // Completed job (portfolio) photos
    match /completedJobs/{userId}/{file=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId && isImage();
    }

    // Default deny — anything outside the paths above.
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
