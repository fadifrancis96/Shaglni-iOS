        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מפרסמים עבודה תוך דקות"
          }
        }
      }
    },
    "onboarding.page2.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرسل المقاولون عروضهم. تحدّث وفاوض واختر الأنسب لك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Contractors send offers. Chat, negotiate, and pick the one that fits."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קבלנים שולחים הצעות מחיר. שוחחו, התמקחו ובחרו את המתאים ביותר."
          }
        }
      }
    },
    "onboarding.page2.title": {
