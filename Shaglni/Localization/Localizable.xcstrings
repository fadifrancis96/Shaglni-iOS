    "onboarding.page1.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صف ما تحتاجه، حدّد ميزانيتك، وتواصل مع محترفين مهرة بالقرب منك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe what you need, set a budget, and reach skilled pros near you."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תארו מה אתם צריכים, קבעו תקציב והגיעו לבעלי מקצוע מיומנים בקרבתכם."
          }
        }
      }
    },
    "onboarding.page1.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انشر أي مهمة خلال دقائق"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Post any job in minutes"
          }
