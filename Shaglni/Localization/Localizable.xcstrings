    "onboarding.page1.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صف ما تحتاجه، حدّد ميزانيتك، وتواصل مع محترفين مهرة بالقرب منك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe what you need, set a budget, and reach skilled pros near you."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תארו מה אתם צריכים, קבעו תקציב והגיעו לבעלי מקצוע מיומנים בקרבתכם."
          }
        }
      }
    },
    "onboarding.page1.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انشر أي مهمة خلال دقائق"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Post any job in minutes"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מפרסמים עבודה תוך דקות"
          }
        }
      }
    },
    "onboarding.page2.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرسل المقاولون عروضهم. تحدّث وفاوض واختر الأنسب لك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Contractors send offers. Chat, negotiate, and pick the one that fits."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קבלנים שולחים הצעות מחיר. שוחחו, התמקחו ובחרו את המתאים ביותר."
          }
        }
      }
    },
    "onboarding.page2.title": {
      "extractionState": "manual",
