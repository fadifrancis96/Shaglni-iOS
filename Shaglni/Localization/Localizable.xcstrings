    "jobDetail.deleteConfirmMessage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to delete this job? This will also delete all associated offers. This action cannot be undone."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل أنت متأكد من حذف هذا العمل؟ سيؤدي ذلك أيضاً إلى حذف جميع العروض المرتبطة به. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האם אתה בטוח שברצונך למחוק עבודה זו? פעולה זו תמחק גם את כל ההצעות הקשורות. לא ניתן לבטל פעולה זו."
          }
        }
      }
    },
    "jobDetail.markInProgressConfirmMessage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will remove the job from public listings and mark it as in progress. Continue?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي هذا إلى إزالة العمل من القوائم العامة ووضع علامة قيد التنفيذ عليه. هل تريد المتابعة؟"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעולה זו תסיר את העבודה מהרשימות הציבוריות ותסמן אותה כבתהליך. להמשיך?"
          }
        }
      }
    },
    "jobDetail.markDoneConfirmMessage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark this job as completed? This action cannot be undone."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد وضع علامة مكتمل على هذا العمل؟ لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לסמן עבודה זו כהושלמה? לא ניתן לבטל פעולה זו."
          }
        }
      }
    },
