          "stringUnit": {
            "state": "translated",
            "value": "تابع الأعمال حتى إتمامها وكوّن معرض أعمال يفوز لك بالمهمة التالية."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
