    "auth.accountLoadFailed.message": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر تحميل بيانات حسابك. تحقق من اتصالك بالإنترنت أو سجّل الخروج ثم أعد تسجيل الدخول."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't load your account data. Check your connection, or sign out and back in."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא הצלחנו לטעון את נתוני החשבון שלך. בדוק את החיבור לאינטרנט או התנתק והתחבר מחדש."
          }
        }
      }
    },
    "auth.accountLoadFailed.title": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر تحميل حسابك"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't load your account"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לטעון את החשבון שלך"
          }
        }
      }
    },
    "auth.confirmDelete.message": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي ذلك إلى حذف وظائفك وعروضك وملفك الشخصي وصورك نهائيًا. لا يمكن التراجع."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently removes your jobs, offers, profile and photos. You can't undo this."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעולה זו תמחק לצמיתות את המשרות, ההצעות, הפרופיל והתמונות שלך. לא ניתן לבטל."
          }
        }
      }
    },
    "auth.confirmDelete.title": {
      "localizations": {
